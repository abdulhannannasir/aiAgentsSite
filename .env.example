# Copy to .env for local development. Real environment variables always win over this file.
# Never commit .env. Full reference: docs/ENVIRONMENT_VARIABLES.md (Phase 11) and README "Configuration".

PORT=3000
# development | production | test
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent (default: info)
# LOG_LEVEL=info

# ---- AI providers --------------------------------------------------------------------------
# Leave both keys blank to run in DEMO mode (instant canned replies, no API key needed).
# Set ONE key to get real answers. If both are set, OpenAI is used unless LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Backup models tried when the main one is overloaded (comma-separated; empty = no backups).
# GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Models agents may be pinned to (comma-separated). Default: just OPENAI_MODEL.
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
# Same for Gemini. Default: GEMINI_MODEL and its backups.
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash

# Optional: force a provider ("gemini", "openai" or "demo").
# LLM_PROVIDER=

# Optional: override endpoints (compatible APIs, or local mocks when testing).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Tools ---------------------------------------------------------------------------------
# Web search uses the Tavily Search API. Without a key the tool is listed as "awaiting configuration" and never offered.
# TAVILY_API_KEY=

# ---- HTTP ----------------------------------------------------------------------------------
# Other sites allowed to call the API (comma-separated, exact origins). Empty = same-origin only.
# CORS_ORIGINS=https://app.example.com
# Number of proxies in front of the app (Render / Railway / Vercel: 1).
# TRUST_PROXY=1
# Chat requests per IP per window (in memory, per instance — a speed bump, not a hard limit).
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=60000

# ---- Accounts (optional; without them the app runs in guest mode) ---------------------------
# PostgreSQL connection string. Apply migrations with `npm run db:migrate` (or `npm run release`).
# DATABASE_URL=postgresql://agentverse:agentverse@localhost:5432/agentverse
# 32+ random characters, e.g. `openssl rand -base64 32`. Signs session cookies and tokens.
# BETTER_AUTH_SECRET=
# The app's public URL: used in email links and as the trusted origin for sign-in requests.
# Default http://localhost:$PORT. With the Vite dev server use http://localhost:5173.
# BETTER_AUTH_URL=http://localhost:3000
# SMTP for verification / password-reset email, e.g. smtp://user:pass@smtp.example.com:587.
# Without it, development logs the emails (with their links); production sends nothing.
# SMTP_URL=
# MAIL_FROM=AgentVerse <no-reply@example.com>
# Require a confirmed email before first sign-in. Default: true when SMTP_URL is set, otherwise false.
# REQUIRE_EMAIL_VERIFICATION=

# ---- Platform services for later phases (unset = shown as "not configured") ----------------
# Redis for durable background jobs and shared rate limits (Phase 5).
# REDIS_URL=redis://localhost:6379
# S3-compatible object storage, e.g. Cloudflare R2 (Phase 7).
# S3_BUCKET=
