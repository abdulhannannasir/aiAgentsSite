PORT=3000

# Leave both keys blank to run in DEMO mode (instant canned replies, no API key needed).
# Set ONE key to get real answers. If both are set, OpenAI is used unless LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: force a provider ("gemini", "openai" or "demo").
# LLM_PROVIDER=

# Optional: override endpoints (compatible APIs, or local mocks when testing).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENAI_BASE_URL=https://api.openai.com/v1
